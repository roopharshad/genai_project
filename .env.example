# Copy to .env and adjust. All values are optional.

# Hosted restoration service (Gradio Space base URL)
RESTORATION_SPACE_URL=https://randomtable-image-restoration-gfpgan.hf.space
# Hugging Face access token, only needed for private or rate-limited Spaces
HF_TOKEN=
RESTORATION_TIMEOUT_SECONDS=300

MAX_UPLOAD_MB=10
# Longest side (px) sent for processing; larger images are downscaled, originals kept
MAX_PROCESS_SIDE=1600
# Document-only pipeline: paper normalization -> protected LaMa repair -> DocRes -> OCR guard
DOCUMENT_ENGINE=docres
DOCRES_MAX_SIZE=512
# One DocRes appearance pass is used after paper normalization for faster CPU restoration
DOCRES_TASK=appearance
# LaMa is limited to safe paper defects outside protected ink (1=enabled)
LAMA_ENABLED=1
# Real-ESRGAN is available as the GFPGAN background upscaler if photo mode is restored later
REALESRGAN_ENABLED=1
REALESRGAN_TILE=256
OCR_DEVICE=cpu
OCR_MKLDNN=0
LAMA_TIMEOUT_SECONDS=180
# Document chat (Gemini) — put the real key only in .env
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Final enhancement step (optional). Cloudflare Workers AI is used when both values are set.
ENHANCEMENT_ENABLED=1
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
