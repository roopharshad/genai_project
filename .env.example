# Copy to .env (local) or set these as environment variables on your hosting platform.
# Never commit real values.

# ---- REQUIRED in production ----
# Random string, at least 32 characters. Without it, logins reset on every restart.
SECRET_KEY=
# Administrator account created on first start
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Port the server listens on (most platforms set this automatically)
PORT=8000

# ---- Document chat (optional; chat is disabled without a key) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-latest

# ---- Restoration pipeline ----
DOCUMENT_ENGINE=docres
DOCRES_MAX_SIZE=512
LAMA_ENABLED=1
LAMA_TIMEOUT_SECONDS=180
OCR_DEVICE=cpu
OCR_MKLDNN=0

# ---- Final enhancement step (off by default: it adds time and needs a paid image API) ----
ENHANCEMENT_ENABLED=0
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
